---
const clients = [
  { name: "Experimental,",        href: "/labs", video: "/videos/experimental1.mp4"},
  
  { name: "Estudio Larco,",       href: "https://www.native-instruments.com", video: "/videos/estudioLarco.mp4" },
  { name: "Heel Chile,",          href: "https://hender-scheme.com" },
  { name: "Producciones 19,",     href: "https://www.bang-olufsen.com" },
  { name: "3D,",                  href: "https://nothing.tech" },
  { name: "Serres Verificadora,", href: "https://www.gentlemonster.com" , video: "/videos/serres.mp4" },
  { name: "Srt Refrigeración,",   href: "https://www.panerai.com" , video: "/videos/srt.mp4"},
  { name: "Experiencias digitales,",           href: "https://fragment.design" , video: "/videos/experience.mp4"},
  { name: "Web Creative,",        href: "https://superfuture.com",    video: "/videos/wca.mp4" },
  { name: "Type Code.",           href: "https://www.sonos.com" },
];
---

<section
  class="relative w-full h-[100svh] p-8 flex flex-col justify-end items-start gap-8 overflow-hidden"
>
  <div
    id="clients-preview"
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[60%] h-1/2 z-0 pointer-events-none"
  ></div>

  <div class="relative z-[1] hidden lg:flex ">
    <p data-split="chars" style="color: #acacac;">Confían en nosotros</p>
  </div>

  <div class="clients-area relative w-4/5 mb-32 z-[2] mix-blend-difference">
    <!-- Texto intro: aparece primero, luego sale -->
    <div id="clients-intro" class="pointer-events-none">
      <p id="clients-intro-p">Construimos productos digitales que los usuarios entienden, usan y recuerdan.</p>
    </div>

    <!-- Nombres de clientes: entran después del intro -->
    <div class="clients-list flex flex-wrap justify-start gap-3">
      {
        clients.map((client) => (
          <a
            href={client.href}
            target="_blank"
            rel="noopener noreferrer"
            data-video={client.video ?? ""}
            class="client-name"
          >
            <h1>{client.name}</h1>
          </a>
        ))
      }
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { SplitText } from "gsap/SplitText";
  import CustomEase from "gsap/CustomEase";

  gsap.registerPlugin(SplitText, CustomEase);

  CustomEase.create(
    "hop",
    "M0,0 C0.071,0.505 0.192,0.726 0.318,0.852 0.45,0.984 0.504,1 1,1"
  );

  // ── Secuencia intro → clientes ────────────────────────────────────────────
  const introEl   = document.getElementById("clients-intro") as HTMLElement;
  const introP    = document.getElementById("clients-intro-p") as HTMLElement;
  const clientEls = document.querySelectorAll<HTMLElement>(".client-name");

  // Clientes ocultos al inicio
  gsap.set(clientEls, { opacity: 0, yPercent: 12 });

  const runIntroSequence = () => {
    document.fonts.ready.then(() => {
      const split = new SplitText(introP, {
        type: "lines, words",
        mask: "lines",
      });

      // 1. Texto entra
      gsap.fromTo(
        split.lines,
        { yPercent: 105 },
        {
          yPercent: 0,
          duration: 0.9,
          stagger: 0.05,
          ease: "expo.out",
          onComplete: () => {
            // 2. Espera 1 seg, luego sale
            gsap.delayedCall(3, () => {
              gsap.to(split.lines, {
                yPercent: -110,
                duration: 0.55,
                stagger: 0.03,
                ease: "power3.in",
                onComplete: () => {
                  introEl.style.display = "none";
                  split.revert();
                  // 3. Clientes entran
                  gsap.to(clientEls, {
                    opacity: 1,
                    yPercent: 0,
                    duration: 0.75,
                    stagger: 0.04,
                    ease: "expo.out",
                  });
                },
              });
            });
          },
        }
      );
    });
  };

  // Esperar el mismo punto que PageTransition
  if (sessionStorage.getItem("__preloaderDone")) {
    gsap.delayedCall(0.35, runIntroSequence);
  } else {
    window.addEventListener("preloaderDone", () => gsap.delayedCall(0.5, runIntroSequence), { once: true });
  }

  const clientsPreview = document.getElementById("clients-preview") as HTMLElement;
  const clientNames = document.querySelectorAll<HTMLElement>(".client-name");
  const isTouch = window.matchMedia("(pointer: coarse)").matches;

  if (isTouch) {
    clientNames.forEach((client) => {
      client.addEventListener("click", (e) => e.preventDefault());
    });
  }

  let activeClientIndex = -1;

  clientNames.forEach((client, index) => {
    let activeWrapper: HTMLDivElement | null = null;
    let activeMedia: HTMLImageElement | HTMLVideoElement | null = null;

    client.addEventListener("mouseover", () => {
      if (activeClientIndex === index) return;

      if (activeClientIndex !== -1) {
        clientNames[activeClientIndex].dispatchEvent(new Event("mouseout"));
      }

      activeClientIndex = index;

      const wrapper = document.createElement("div");
      wrapper.className = "client-img-wrapper";

      const videoSrc = client.dataset.video;
      let media: HTMLImageElement | HTMLVideoElement;

      if (videoSrc) {
        const video = document.createElement("video");
        video.src = videoSrc;
        video.autoplay = true;
        video.muted = true;
        video.loop = true;
        video.playsInline = true;
        video.style.cssText = "width:100%;height:100%;object-fit:cover;";
        media = video;
      } else {
        const img = document.createElement("img");
        img.src = `/img${index + 1}.jpg`;
        img.alt = "";
        media = img;
      }

      gsap.set(media, { scale: 1.25, opacity: 0 });
      gsap.set(wrapper, { clipPath: "polygon(50% 50%, 50% 50%, 50% 50%, 50% 50%)" });

      wrapper.appendChild(media);
      clientsPreview.appendChild(wrapper);

      if (media instanceof HTMLVideoElement) {
        media.play().catch(() => {});
      }

      activeWrapper = wrapper;
      activeMedia = media;

      gsap.to(wrapper, {
        clipPath: "polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%)",
        duration: 0.5,
        ease: "hop",
      });

      gsap.to(media, { opacity: 1, duration: 0.25, ease: "power2.out" });
      gsap.to(media, { scale: 1, duration: 1.25, ease: "hop" });
    });

    client.addEventListener("mouseout", (event) => {
      const e = event as MouseEvent;
      if (e.relatedTarget && client.contains(e.relatedTarget as Node)) return;

      if (activeClientIndex === index) activeClientIndex = -1;

      if (activeMedia && activeWrapper) {
        const mediaToRemove = activeMedia;
        const wrapperToRemove = activeWrapper;

        activeMedia = null;
        activeWrapper = null;

        gsap.to(mediaToRemove, {
          opacity: 0,
          duration: 0.5,
          ease: "power1.out",
          onComplete: () => {
            if (mediaToRemove instanceof HTMLVideoElement) mediaToRemove.pause();
            wrapperToRemove.remove();
          },
        });
      }
    });
  });
</script>

<style>
  .clients-area {
    min-height: 6rem;
  }

  #clients-intro {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
  }

  #clients-intro-p {
    font-family: var(--font-sans) !important;
    font-size: clamp(1.8rem, 3.5vw, 4.5rem) !important;
    font-weight: 500 !important;
    letter-spacing: -0.03em !important;
    line-height: 1.1 !important;
    text-transform: none !important;
    color: #fff !important;
    margin: 0 !important;
  }

  @media (max-width: 1023px) {
    .clients-area {
      margin-bottom: 2rem;
    }
  }
</style>
