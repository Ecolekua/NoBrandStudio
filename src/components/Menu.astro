---
import OverlayMenu from "./OverlayMenu.astro";
---

<nav class="fixed top-0 w-full mix-blend-difference z-[11]">
  <div class="grid grid-cols-3 lg:grid-cols-4 items-center px-8 py-4">

    <div class="flex items-center">
      <a id="logo-link" href="/">No Brand Studio.</a>
      <span class="typing-indicator">█</span>
    </div>

    <p data-split="words">Santiago, chile<br />Creative Technologist</p>
    <div id="nav-links" class="hidden lg:flex gap-6 items-center">

      <a data-split="words" href="/"><span class="typing-indicator">█</span></a>
      <a data-split="words" href="/studio">Studio</a>
      <a data-split="words" href="/projects">Projects</a>
      <a data-split="words" href="/labs">Labs</a>
      <a data-split="words" href="/contacto">Contacto</a>

    </div>

    <button id="menu-toggle" class="ml-auto lg:hidden hamburger" aria-label="Menu">
      <span class="bar"></span>
      <span class="bar"></span>
      <span class="bar"></span>
    </button>

  </div>
</nav>

<OverlayMenu />

<script is:inline src="/ScrambleTextPlugin.min.js"></script>

<script>
  import gsap from "gsap";

  gsap.registerPlugin((window as any).ScrambleTextPlugin);

  const logoLink = document.getElementById("logo-link") as HTMLElement;
  gsap.set(logoLink, { opacity: 0 });

  const runScramble = () => {
    gsap.registerPlugin((window as any).ScrambleTextPlugin);
    logoLink.textContent = "";
    gsap.set(logoLink, { opacity: 1 });
    gsap.to(logoLink, {
      duration: 2,
      scrambleText: {
        text: "No Brand Studio.",
        chars: "lowerCase",
        speed: 0.4,
        tweenLength: false,
      },
      ease: "none",
    });
  };

  if (sessionStorage.getItem("__preloaderDone")) {
    gsap.delayedCall(0.15, runScramble);
  } else {
    window.addEventListener("preloaderDone", () => gsap.delayedCall(0.2, runScramble), { once: true });
  }
</script>

<style>
  button {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
  }

  a, p, .typing-indicator {
    color: white;
    text-decoration: none;
    text-transform: uppercase;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 550;
    line-height: 1;
    display: inline-block;
  }

  .hamburger {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 22px;
    height: 14px;
    opacity: 0;
  }

  @media (min-width: 1024px) {
    .hamburger { display: none; }
  }

  .bar {
    display: block;
    width: 100%;
    height: 1.5px;
    background: white;
    transition: transform 0.35s ease, opacity 0.2s ease;
    transform-origin: center;
  }

  .hamburger.is-open .bar:nth-child(1) { transform: translateY(6.25px) rotate(45deg); }
  .hamburger.is-open .bar:nth-child(2) { opacity: 0; }
  .hamburger.is-open .bar:nth-child(3) { transform: translateY(-6.25px) rotate(-45deg); }

  p {
    display: block;
    line-height: 1.4;
  }

  @media (max-width: 1023px) {
    p { visibility: hidden; pointer-events: none; }
  }

  .typing-indicator {
    display: inline-block;
    animation: blink-cursor 0.7s step-end infinite;
  }

  @keyframes blink-cursor {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0; }
  }
</style>
