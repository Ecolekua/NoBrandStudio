---
const { size, class: className, ...rest } = Astro.props;
const sizeMap: Record<string, string[]> = {
  xs: ["size-3"], sm: ["size-4"], base: ["size-5"],
  md: ["size-6"], lg: ["size-7"], xl: ["size-8"],
};
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={["icon", sizeMap[size], className]}
  {...rest}
>
  <path d="M5 12h14" />
  <path d="m13 6 6 6-6 6" />
</svg>
