---
import Logo from "@/components/studio/assets/Logo.astro";
import Text from "@/components/studio/fundations/elements/Text.astro";
import Wrapper from "@/components/studio/fundations/containers/Wrapper.astro";

const links = [
  { href: "#work", text: "Work" },
  { href: "#projects", text: "Projects" },
  { href: "#education", text: "Education" },
  { href: "#speaking", text: "Speaking" },
];
---

<nav class="bg-white dark:bg-base-950 fixed top-0 z-10 w-full">
  <Wrapper variant="standard" class="py-2">
    <div class="grid grid-cols-3 lg:grid-cols-4 items-start">
      <a href="/" class="-mt-1 flex">
        <Logo class="text-base-600 dark:text-base-300 text-xs tracking-tight" />
      </a>
      <Text
        tag="p"
        variant="textXS"
        class="text-base-600 dark:text-base-300 tracking-tight"
      >
        Santiago, chile<br />Creative Technologist
      </Text>
      <div class="hidden lg:flex gap-8 text-sm items-center">
        {
          links.map((link) => (
            <a
              href={link.href}
              class="text-base-600 dark:text-base-300 tracking-tight text-xs"
            >
              {link.text}
            </a>
          ))
        }
      </div>
      <a class="text-base-600 dark:text-base-300 text-xs tracking-tight ml-auto">
        Download
      </a>
    </div>
  </Wrapper>
</nav>
