---
import { Image } from "astro:assets";
import one from "@/images/projects/one.png";
import two from "@/images/projects/two.png";
import three from "@/images/projects/three.png";
import Text from "@/components/studio/fundations/elements/Text.astro";
import Wrapper from "@/components/studio/fundations/containers/Wrapper.astro";

type Project = {
  year: string;
  title: string;
  description: string;
  category: string;
  video?: string;
  image?: ImageMetadata;
  imageAlt?: string;
};

const featuredProjects: Project[] = [
  {
    year: "2026",
    title: "Serres Document Platform",
    description:
      "Una plataforma integral de gestión documental orientada a procesos de certificación laboral, validación de contratistas y auditorías empresariales. El sistema centraliza trazabilidad documental, monitoreo de cumplimiento y automatización de flujos operativos para entornos corporativos de alta exigencia.",
    category: "Sistemas de Gestión Documental",
    video: "/videos/serres.mp4",
  },
  {
    year: "2026",
    title: "Estudio Larco Digital Experience",
    description:
      "Desarrollo de una experiencia digital contemporánea para un estudio de arquitectura, enfocada en narrativa visual, presentación editorial de proyectos y visualización arquitectónica inmersiva. El sitio integra transiciones cinematográficas, layouts responsivos y una estética minimalista orientada a proyectos de alto estándar.",
    category: "Arquitectura y Experiencia Digital",
    video: "/videos/estudioLarco.mp4",
  },
  {
    year: "2026",
    title: "Heel Visual Sanitation System",
    description:
      "Sistema experimental de sanitización y reconocimiento visual desarrollado para entornos de laboratorio y procesos controlados. La solución integra monitoreo en tiempo real, automatización de protocolos higiénicos y tecnologías de reconocimiento visual para optimizar seguridad y control operacional.",
    category: "Tecnología para Laboratorios",
    image: one,
    imageAlt: "Laboratorio moderno con interfaces de monitoreo sanitario, reconocimiento visual y automatización de protocolos de higiene.",
  },
  {
    year: "2026",
    title: "Producciones19 Interactive Events",
    description:
      "Plataforma creativa orientada a experiencias digitales para eventos, integrando desarrollo web, instalaciones interactivas y tecnologías inmersivas para activaciones de marca, espectáculos y producciones en vivo. El proyecto combina motion graphics, interacción en tiempo real y experiencias audiovisuales.",
    category: "Experiencias Tecnológicas y Eventos",
    video: "/videos/p19.mp4"  ,
  },
  {
    year: "2026",
    title: "3D Product Visualization Lab",
    description:
      "Iniciativa enfocada en modelado 3D de productos y desarrollo de experiencias web interactivas para visualización digital avanzada. El proyecto conecta diseño industrial, renderizado en tiempo real y tecnologías web modernas para presentación inmersiva de productos y prototipos.",
    category: "Visualización 3D y Desarrollo Web",
  video: "/videos/vizlab.mp4",
  },
  {
    year: "2026",
    title: "SRT Refrigeración Web Platform",
    description:
      "Diseño y desarrollo de una plataforma digital corporativa para servicios de refrigeración industrial, orientada a mostrar soluciones técnicas, infraestructura especializada y capacidades operativas mediante una experiencia web moderna y optimizada.",
    category: "Sitios Web Corporativos Industriales",
   video: "/videos/srt.mp4", },
  {
    year: "2026",
    title: "UX Creative Systems",
    description:
      "Proyecto conceptual de diseño UX enfocado en experiencias digitales inmersivas, interacción avanzada y sistemas visuales adaptativos. La propuesta combina narrativa interactiva, motion design y principios de accesibilidad para construir experiencias web emocionales y funcionales.",
    category: "UX Design y Tecnología Creativa",
    video: "/videos/experience.mp4",
    
  },
  {
    year: "2026",
    title: "Typecode Technical Support Network",
    description:
      "Framework de apoyo técnico e implementación de sistemas orientado a integración tecnológica, despliegue de plataformas digitales y optimización de flujos operacionales para entornos creativos y corporativos.",
    category: "Implementación y Soporte Técnico",
    image: two,
    imageAlt: "Panel técnico mostrando monitoreo de sistemas, despliegues digitales e integración de infraestructura tecnológica.",
  },
];
---

<section class="scroll-mt-32" id="projects">
  <Wrapper variant="standard" class="py-12 lg:py-24">
    <div class="grid grid-cols-1 lg:grid-cols-4 items-start">
      <div class="lg:col-start-2">
        <Text tag="p" variant="textSM" class="text-base-600 dark:text-base-300">
          Featured Projects<br />2026 - Now
        </Text>
      </div>
      <Text
        tag="h2"
        variant="textXL"
        class="font-semibold leading-snug text-left tracking-tighter lg:col-span-2 text-base-900 dark:text-white"
      >
        Projects
      </Text>
    </div>
    <div class="flex flex-col gap-12 mt-8">
      {
        featuredProjects.map((project) => (
          <article class="py-12 border-t border-base-200 dark:border-base-800">
            <div data-animate="block" class="grid grid-cols-1 gap-4 lg:grid-cols-4 items-start">
              <Text tag="p" variant="textXS" class="text-base-600 dark:text-base-300 uppercase">
                {project.year}
              </Text>
              <Text tag="h3" variant="displaySM" class="text-base-900 dark:text-white leading-tight font-semibold">
                {project.title}
              </Text>
              <Text tag="p" variant="textSM" class="text-base-600 dark:text-base-300">
                {project.description}
              </Text>
              <Text tag="p" variant="textXS" class="text-base-600 dark:text-base-300 uppercase lg:ml-auto lg:col-start-4">
                {project.category}
              </Text>
            </div>
            {project.video ? (
              <video
                data-animate="img"
                src={project.video}
                autoplay
                muted
                loop
                playsinline
                class="size-full aspect-[4/2] lg:aspect-[4/1] mt-12 object-cover object-center"
              />
            ) : (
              <Image
                data-animate="img"
                width={1200}
                height={630}
                src={project.image!}
                alt={project.imageAlt!}
                loading="lazy"
                decoding="async"
                class="size-full aspect-[4/2] lg:aspect-[4/1] mt-12 object-cover object-center"
              />
            )}
          </article>
        ))
      }
    </div>
  </Wrapper>
</section>
