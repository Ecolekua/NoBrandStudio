---
import Text from "@/components/studio/fundations/elements/Text.astro";
import Wrapper from "@/components/studio/fundations/containers/Wrapper.astro";
import ArrowRight from "@/components/studio/fundations/icons/ArrowRight.astro";

const featuredProjects = [
  {
    year: "2026",
    title: "Nosotros",
    description:
      "En No Brand Studio, entendemos que la creatividad no es solo una habilidad, sino una forma de pensar.Nacimos en Chile a partir de una convicción: diseñar con intención desafiando lo obvio y construyendo experiencias significativas. Somos un estudio multidisciplinario de diseño y tecnología, donde convergen diseño, estrategia y desarrollo para dar vida a productos centrados en la experiencia de usuario. Hoy, colaboramos con clientes y equipos que buscan ir más allá de lo convencional, desarrollando soluciones digitales, identidades y productos que combinan funcionalidad, estética y propósito.",
    category: "",
  },
];
---

<section class="scroll-mt-32" id="work">
  <Wrapper variant="standard" class="py-12 lg:py-24">
    <div class="grid grid-cols-1 lg:grid-cols-4 items-start">
      <div class="lg:col-start-2">
        <Text tag="p" variant="textSM" class="text-base-600 dark:text-base-300">
          Featured Work<br />2026 - Now
        </Text>
      </div>
      <Text
        tag="h2"
        variant="textXL"
        class="font-semibold leading-snug text-left tracking-tighter lg:col-span-2 text-base-900 dark:text-white"
      >
        Work
      </Text>
    </div>
    <div class="flex flex-col lg:gap-12 mt-8">
      {
        featuredProjects.map((project) => (
          <article class="py-12 border-t border-base-200 dark:border-base-800">
            <div data-animate="block" class="grid grid-cols-1 gap-4 lg:grid-cols-4 items-start">
              <Text tag="p" variant="textXS" class="text-base-600 dark:text-base-300 uppercase">
                {project.year}
              </Text>
              <Text tag="h3" variant="displaySM"  data-split="words" class="text-base-900 dark:text-white leading-tight font-semibold">
                {project.title}
              </Text>
              <Text tag="p" variant="textSM" data-split="words" class="text-base-600 dark:text-base-300">
                {project.description}
              </Text>
              <Text tag="p" variant="textXS" class="text-base-600 dark:text-base-300 uppercase lg:ml-auto lg:col-start-4">
                {project.category} <ArrowRight class="size-4" /> 
              </Text>
              
            </div>
            <video
              data-animate="work-video"
              src="/videos/experimental1.mp4"
              autoplay
              muted
              loop
              playsinline
              class="size-full aspect-4/2 mt-12 object-cover object-center"
            />
          </article>
        ))
      }
    </div>
  </Wrapper>
</section>

<script>
  import gsap from "gsap";

  const video = document.querySelector<HTMLElement>('[data-animate="work-video"]');
  if (video) {
    gsap.fromTo(
      video,
      { yPercent: 12, autoAlpha: 0 },
      { yPercent: 0, autoAlpha: 1, duration: 1, ease: "power3.out", delay: 0.6 }
    );
  }
</script>

<style>
  [data-animate="work-video"] {
    opacity: 0;
  }
</style>
