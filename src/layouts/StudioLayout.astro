---
import "@/styles/global.css";
import BaseHead from "@/components/studio/fundations/head/BaseHead.astro";
import PageTransition from "@/components/PageTransition.astro";
import Menu from "@/components/Menu.astro";
import Footer from "@/components/studio/global/Footer.astro";
import StudioAnimations from "@/components/StudioAnimations.astro";
---

<html lang="en" class="scroll-smooth">
  <head>
    <BaseHead />
  </head>
  <body class="bg-sand dark:bg-base-950 flex flex-col min-h-svh font-sans">
    <PageTransition />
    <Menu />
    <main class="grow">
      <slot />
    </main>
    <Footer />
    <StudioAnimations />
  </body>
</html>
