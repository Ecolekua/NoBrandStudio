---
import "@/styles/global.css";
import BaseHead from "@/components/studio/fundations/head/BaseHead.astro";
import PageTransition from "@/components/PageTransition.astro";
import Menu from "@/components/Menu.astro";
---

<html lang="es" class="scroll-smooth">
  <head>
    <BaseHead />
    <title>Contacto — No Brand Studio</title>
  </head>
  <body class="font-sans" style="background:var(--modal-bg);">
    <PageTransition />
    <Menu />

    <main>
      <section id="contact-root">

        <div class="contact-copy">

          <div class="contact-col">
            <h2 data-split="lines">No brand,<br />full intention.</h2>
          </div>

          <div class="contact-col">

            <div class="contact-group" data-anim data-delay="0.2">
              <p class="label">Enfoque</p>
              <p>Dirección Creativa</p>
              <p>Identidad de Marca</p>
              <p>Experiencia Digital</p>
            </div>

            <div class="contact-group" data-anim data-delay="0.45">
              <p class="label">Base</p>
              <p>Santiago, Chile</p>
            </div>

            <div class="contact-mail" data-anim data-delay="0.65">
              
                <a href="mailto:hello@nobrandstudio.com">
                  <h3>hello@nobrandstudio.com</h3>
                  </a>
                
            </div>

            <div class="contact-group" data-anim data-delay="0.85">
              <p class="label">Estudio</p>
              <p>No Brand Studio</p>
              <p>© 2025</p>
            </div>

          </div>

        </div>

        <footer class="contact-footer" data-anim data-delay="1.35">
          <div class="contact-footer-inner">
            <p class="sm">Disponible para proyectos</p>
            <div class="contact-socials">
              <a class="sm" href="#_">LinkedIn</a>
              <a class="sm" href="#_">GitHub</a>
              <a class="sm" href="#_">Arena</a>
            </div>
            <p class="sm">No Brand Studio</p>
          </div>
        </footer>

      </section>
    </main>


    <script>
      import gsap from "gsap";
      import { SplitText } from "gsap/SplitText";
      import * as THREE from "three";
      import { GLTFLoader } from "three/examples/jsm/loaders/GLTFLoader.js";

      gsap.registerPlugin(SplitText);

      // ── Screensaver: objetos 3D rebotando ───────────────────────────────────────
      const MODELS = [
        { path: "/models/gameboy.glb",  scale: 0.06 },
        { path: "/models/monitor.glb", scale: 1   },
        { path: "/models/vhs.glb",     scale: 1   },
        { path: "/models/tape.glb",    scale: 2 }, // ← ajusta escala aquí
      ];
      const isMobile = window.innerWidth < 1024;
      const CFG = { speed: isMobile ? 0.3 : 1.2, size: isMobile ? 300 : 480, edgeOffset: -40, changeDelay: 20 };

      const root = document.getElementById("contact-root")!;
      let rId: number | null = null;
      let wrapper: HTMLElement | null = null;
      let threeRenderer: THREE.WebGLRenderer | null = null;

      const stopSS = () => {
        if (rId !== null) { cancelAnimationFrame(rId); rId = null; }
        threeRenderer?.dispose();
        threeRenderer = null;
        wrapper?.remove();
        wrapper = null;
      };

      const startSS = () => {
        stopSS();

        // ── Contenedor ────────────────────────────────────────────────────────────
        wrapper = document.createElement("div");
        wrapper.style.cssText = `position:absolute;width:${CFG.size}px;height:${CFG.size}px;pointer-events:none;z-index:0;overflow:hidden;`;
        root.appendChild(wrapper);

        // ── Three.js ──────────────────────────────────────────────────────────────
        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(30, 1, 0.1, 1000);
        camera.position.set(0, 0.15, 0.7);
        camera.lookAt(0, 0, 0);

        threeRenderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
        threeRenderer.setSize(CFG.size, CFG.size);
        threeRenderer.setPixelRatio(Math.min(devicePixelRatio, 2));
        threeRenderer.toneMapping = THREE.ACESFilmicToneMapping;
        threeRenderer.toneMappingExposure = 1.25;
        wrapper.appendChild(threeRenderer.domElement);

        // ── Iluminación ───────────────────────────────────────────────────────────
        scene.add(new THREE.AmbientLight(0xffffff, 5));
        const dirLight = new THREE.DirectionalLight(0xffffff, 2.5);
        dirLight.position.set(15, 10, -5);
        scene.add(dirLight);
        const topLight = new THREE.PointLight(0xffffff, 5, 10);
        topLight.position.set(-5, -2.5, 0);
        topLight.decay = 0.3;
        scene.add(topLight);

        const monitorGroup = new THREE.Group();
        scene.add(monitorGroup);

        // ── Precargar modelos ─────────────────────────────────────────────────────
        const loadedModels: THREE.Group[] = new Array(MODELS.length);
        let modelIdx = 0;
        let modelsReady = false;
        let loadedCount = 0;
        const loader = new GLTFLoader();

        MODELS.forEach(({ path, scale }, i) => {
          loader.load(path, (gltf) => {
            const model = gltf.scene;
            // Escalar primero, luego centrar — así el bounding box es exacto
            model.scale.setScalar(scale);
            const center = new THREE.Box3().setFromObject(model).getCenter(new THREE.Vector3());
            model.position.sub(center);
            loadedModels[i] = model;
            loadedCount++;
            if (loadedCount === MODELS.length) {
              monitorGroup.add(loadedModels[0]);
              modelsReady = true;
            }
          });
        });

        // ── Swap de modelo en cada colisión ───────────────────────────────────────
        const swapModel = () => {
          monitorGroup.remove(loadedModels[modelIdx]);
          modelIdx = (modelIdx + 1) % MODELS.length;
          monitorGroup.add(loadedModels[modelIdx]);
          // Salto de ángulo amplio para que el cambio sea visible
          targetRY += Math.PI * (0.6 + Math.random() * 0.6) * (Math.random() > 0.5 ? 1 : -1);
          targetRX  = (Math.random() - 0.5) * Math.PI * 0.5;
        };

        // ── Posición y velocidad inicial ──────────────────────────────────────────
        let x = root.offsetWidth  / 2 - CFG.size / 2;
        let y = root.offsetHeight / 2 - CFG.size / 2;
        let vx = (Math.random() > 0.5 ? 1 : -1) * CFG.speed;
        let vy = (Math.random() > 0.5 ? 1 : -1) * CFG.speed;
        let canChange = true;

        wrapper.style.left = `${x}px`;
        wrapper.style.top  = `${y}px`;

        // ── Rotación objetivo ─────────────────────────────────────────────────────
        let targetRY = 0;
        let targetRX = 0;
        let lerpedRY = 0;
        let lerpedRX = 0;
        let elapsed  = 0;

        const step = () => {
          if (!wrapper?.parentNode) return;
          x += vx;
          y += vy;
          elapsed += 0.016;

          const L = 0;
          const R = root.offsetWidth  - CFG.size;
          const T = 0;
          const B = root.offsetHeight - CFG.size;

          if ((x <= L || x >= R) && canChange) {
            vx = -vx;
            x = x <= L ? L : R;
            if (modelsReady) swapModel();
            canChange = false;
            setTimeout(() => { canChange = true; }, CFG.changeDelay);
          }

          if ((y <= T || y >= B) && canChange) {
            vy = -vy;
            y = y <= T ? T : B;
            if (modelsReady) swapModel();
            canChange = false;
            setTimeout(() => { canChange = true; }, CFG.changeDelay);
          }

          wrapper!.style.left = `${x}px`;
          wrapper!.style.top  = `${y}px`;

          // Rotación continua — targetRY avanza constantemente
          targetRY += 0.004;
          lerpedRY = gsap.utils.interpolate(lerpedRY, targetRY, 0.015);
          lerpedRX = gsap.utils.interpolate(lerpedRX, targetRX, 0.015);
          monitorGroup.rotation.y = lerpedRY;
          monitorGroup.rotation.x = lerpedRX + Math.sin(elapsed * 0.35) * 0.06;

          threeRenderer!.render(scene, camera);
          rId = requestAnimationFrame(step);
        };

        rId = requestAnimationFrame(step);
      };

      startSS();

      // ── Animate contact groups ───────────────────────────────────────────────────
      const animateGroups = () => {
        document.querySelectorAll<HTMLElement>("[data-anim]").forEach((el) => {
          const delay = parseFloat(el.dataset.delay ?? "0.1");
          gsap.fromTo(el,
            { autoAlpha: 0, y: 18 },
            { autoAlpha: 1, y: 0, duration: 0.75, delay, ease: "power3.out" }
          );
        });
      };

      // Si carga dentro del modal (iframe): sin scroll y sin menú
      if (window !== window.parent) {
        document.body.style.overflow = "hidden";
        document.documentElement.style.overflow = "hidden";
        const nav = document.querySelector("nav");
        if (nav) nav.style.display = "none";
      }

      // ── Trigger animations: page-load or direct visit ────────────────────────────
      Promise.resolve().then(() => {
        if (sessionStorage.getItem("__preloaderDone")) {
          gsap.delayedCall(0.15, animateGroups);
        } else {
          sessionStorage.setItem("__preloaderDone", "1");
          window.dispatchEvent(new Event("preloaderDone"));
          gsap.delayedCall(0.15, animateGroups);
        }
      });
    </script>

    <style>
      /* ── Color del modal — cambia aquí ──────────────────────────── */
      :root { --modal-bg: #e85500; }

      /* ── Section container ──────────────────────────────────────── */
      #contact-root {
        position: relative;
        width: 100vw;
        height: 100svh;
        display: flex;
        justify-content: center;
        align-items: center;
        overflow: hidden;
      }

      /* ── Two-column content area ────────────────────────────────── */
      .contact-copy {
        position: relative;
        z-index: 1;
        width: 75%;
        max-width: 2000px;
        display: flex;
        gap: 2rem;
        padding: 0 2rem;
      }

      .contact-col:first-child { flex: 3; }
      .contact-col:last-child {
        flex: 2;
        display: flex;
        flex-direction: column;
        gap: 2rem;
      }

      .contact-col h2 {
        width: 65%;
        font-size: clamp(2rem, 3.5vw, 3.5rem);
        font-weight: 500;
        line-height: 1.1;
        color: #fff;
      }

      /* ── Contact groups (focus / base / credits) ────────────────── */
      .contact-group {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
        font-family: var(--font-mono);
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: #fff;
      }

      .contact-group .label {
        color: rgba(255,255,255,0.55);
        font-size: 0.7rem;
        margin-bottom: 0.35rem;
      }

      /* ── Email link ─────────────────────────────────────────────── */
      .contact-mail a {
        font-family: var(--font-mono);
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: #fff;
        text-decoration: none;
        display: inline-block;
        position: relative;
      }

      .contact-mail a::after {
        content: "";
        position: absolute;
        bottom: -2px;
        left: 0;
        width: 100%;
        height: 1px;
        background: currentColor;
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.4s ease;
      }

      .contact-mail a:hover::after { transform: scaleX(1); }

      /* ── Footer (absolute at bottom) ───────────────────────────── */
      .contact-footer {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        z-index: 1;
      }

      .contact-footer-inner {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        padding: 2rem;
      }

      .contact-socials { display: flex; gap: 2rem; }

      .sm {
        font-family: var(--font-mono);
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: rgba(255,255,255,0.7);
        text-decoration: none;
        display: inline-block;
      }

      a.sm { transition: color 0.2s ease; }
      a.sm:hover { color: #fff; }

      /* data-anim elements start hidden — GSAP reveals them */
      [data-anim] { opacity: 0; }

      /* ── Mobile ─────────────────────────────────────────────────── */
      @media (max-width: 1023px) {
        #contact-root {
          height: auto;
          min-height: 100svh;
          padding: 8rem 0 6rem;
          align-items: flex-start;
        }

        .contact-copy {
          flex-direction: column;
          width: 100%;
          gap: 3rem;
          padding: 1.25rem;
        }

        .contact-col h2 { width: 90%; }

        .contact-footer {
          position: relative;
          padding-bottom: 2rem;
        }

        .contact-footer-inner {
          flex-direction: column;
          align-items: flex-start;
          gap: 0.5rem;
          padding: 1.25rem;
        }

        .contact-socials {
          flex-direction: column;
          gap: 0.5rem;
        }
      }
    </style>
  </body>
</html>
